package ui

import (
	"fmt"

	"github.com/codepuke/codepuke/internal/store"
)

templ RecordRow(index int, a store.ArticleSummary) {
	<div class="record-row">
		<span class="offset">{ Offset(index) }</span>
		<span class="date">{ Date(a.PublishedAt) }</span>
		<div class="body">
			<div class="title"><a href={ templ.URL("/articles/" + a.Slug) }>{ a.Title }</a></div>
			<div class="meta">
				<span>{ a.Author + " //" }</span>
				@TagChips(a.TagSlugs, a.TagNames)
			</div>
		</div>
	</div>
}

templ TagChips(slugs, names []string) {
	for i, slug := range slugs {
		<a class="tag-chip" href={ templ.URL("/tags/" + slug) }>{ names[i] }</a>
	}
}

templ ArchiveRow(a store.ArticleSummary) {
	<div class="archive-row">
		<span class="date">{ Date(a.PublishedAt) }</span>
		<span class="title"><a href={ templ.URL("/articles/" + a.Slug) }>{ a.Title }</a></span>
		<span class="tags">
			for i, name := range a.TagNames {
				if i > 0 {
					{ ", " }
				}
				{ name }
			}
		</span>
	</div>
}

templ FamilyHead(f store.Family, projectCount int) {
	<div class="family-head">
		<div>
			<span class="family-name">{ f.Name }</span>
			<span class="family-desc">{ "// " + f.Descriptor }</span>
		</div>
		<span class="count">{ fmt.Sprintf("%d projects", projectCount) }</span>
	</div>
}

templ FamilyLine(f store.Family) {
	<div class="family-line">
		<span class="family-name">{ f.Name }</span>
		<span class="family-desc">{ "// " + f.Descriptor }</span>
	</div>
}

templ Card(c ProjectCard) {
	<div class="card">
		<div class="card-name">{ c.Project.Name }</div>
		<div class="card-desc">{ c.Project.Description }</div>
		<div class="card-foot">
			if c.Project.Version != nil {
				<span class="card-ver">{ *c.Project.Version }</span>
			}
			if c.Project.RepoURL != nil {
				@GitHubMark(*c.Project.RepoURL, c.Project.Name)
			}
			<a class="card-open" href={ templ.URL(c.OpenURL) }>open</a>
		</div>
	</div>
}

// GitHubMark is the one inline icon on the site: a currentColor octicon
// linking a project's repository. No webfont, no image request.
templ GitHubMark(repoURL, projectName string) {
	<a class="gh-mark" href={ templ.URL(repoURL) } aria-label={ projectName + " on GitHub" }>
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
		</svg>
	</a>
}

// DocsNav is rendered twice per docs page: once in the sidebar column, once
// inside the phone contents bar. CSS shows exactly one.
templ DocsNav(nav DocsNavModel) {
	<nav class="docs-nav" aria-label="documentation">
		<div class="docs-project">
			{ nav.ProjectName }
			if nav.Version != "" {
				<span class="ver">{ nav.Version }</span>
			}
		</div>
		for i, item := range nav.Items {
			if item.Active {
				<a class="nav-item on" href={ templ.URL(item.URL) } aria-current="page"><span>{ NavNum(i) }</span>{ item.Title }</a>
				if len(item.Sections) > 0 {
					<ul class="nav-sub">
						for _, s := range item.Sections {
							<li data-title={ s.Title }><a href={ templ.URL("#" + s.ID) }><span>{ s.Label }</span> { s.Title }</a></li>
						}
					</ul>
				}
			} else {
				<a class="nav-item" href={ templ.URL(item.URL) }><span>{ NavNum(i) }</span>{ item.Title }</a>
			}
		}
	</nav>
}
